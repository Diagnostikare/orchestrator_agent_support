# Ambiente: beta. Versionado, SIN secretos.
#
# Las variables DEPLOY_* son para deploy.sh y NO se suben al reasoningEngine.
# El resto se copia tal cual a agent/.env, que es lo que `adk deploy` sube como
# environment del agente.

DEPLOY_PROJECT=architecture-beta
DEPLOY_REGION=us-central1
DEPLOY_DISPLAY_NAME=Soporte Diagnostikare
# Instancia que core-api tiene configurada (CORA_SUPPORT_AGENT_ID).
# Con este valor el deploy ACTUALIZA esa instancia. Vacio = crea una nueva.
DEPLOY_ENGINE_ID=6890865320911699968
# Secreto de Secret Manager que se resuelve en tiempo de deploy y se inyecta
# como AGENT_API_SECRET. Debe ser el mismo que usa el Cloud Run de core-api.
DEPLOY_SECRET_AGENT_API=AGENT_API_SECRET

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=architecture-beta
# Region del reasoningEngine. us-central1 porque AgentRegistry en core-api la
# tiene hardcodeada. NO afecta al modelo: ese va anclado a `global` en models.py.
GOOGLE_CLOUD_LOCATION=us-central1

DOCS_DATASTORE_STANDARD=orquestor-support-collection_documents
# `medical` apunta al mismo dataStore: hoy no hay documentacion restringida a
# personal medico. El codigo ya soporta uno distinto por categoria.
DOCS_DATASTORE_MEDICAL=orquestor-support-collection_documents

CORE_API_BASE_URL=https://core-api-beta.diagnostikare.com
