# Ambiente: production. Versionado, SIN secretos.
#
# OJO: produccion todavia NO tiene el agente desplegado ni la infra de
# Discovery Engine completa. Antes del primer deploy hay que correr los pasos
# 1 a 4 de docs/deploy-produccion.md (dataStore, app de busqueda, import, IAM
# del service agent). Sin el paso 4 el agente despliega bien y
# `buscar_documentacion` falla en silencio en cada llamada.

DEPLOY_PROJECT=architecture-production
DEPLOY_REGION=us-central1
DEPLOY_DISPLAY_NAME=Soporte Diagnostikare
# Vacio a proposito: el primer deploy crea un engine NUEVO y no toca
# `cora-support-assistant` (6733783592209481728). Al terminar, anotar aqui el
# ID que imprime el deploy; a partir de ahi los deploys actualizan esa
# instancia en vez de crear otra.
DEPLOY_ENGINE_ID=
DEPLOY_SECRET_AGENT_API=AGENT_API_SECRET

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=architecture-production
GOOGLE_CLOUD_LOCATION=us-central1

DOCS_DATASTORE_STANDARD=orquestor-support-collection_documents
DOCS_DATASTORE_MEDICAL=orquestor-support-collection_documents

# PENDIENTE: host de core-api de produccion, sin slash final. Lo tiene backend.
# Si queda vacio, deploy.sh se detiene antes de subir nada.
CORE_API_BASE_URL=https://core-api-beta.diagnostikare.com
