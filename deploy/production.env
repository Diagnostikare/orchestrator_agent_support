# Ambiente: production. Versionado, SIN secretos.
#
# El primer deploy (2026-09-11) creo el engine de abajo y core-api de
# produccion ya apunta a el (`CORA_SUPPORT_AGENT_ID` en
# diagnostikare-core-api-production). La infra de Discovery Engine (pasos 1 a 4
# de docs/deploy-produccion.md) esta hecha.

DEPLOY_PROJECT=architecture-production
DEPLOY_REGION=us-central1
DEPLOY_DISPLAY_NAME=Soporte Diagnostikare
# El engine que usa core-api de produccion. Vaciarlo hace que deploy.sh cree
# uno NUEVO, y core-api seguiria hablandole a este.
DEPLOY_ENGINE_ID=969872060035629056
DEPLOY_SECRET_AGENT_API=AGENT_API_SECRET

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=architecture-production
GOOGLE_CLOUD_LOCATION=us-central1

DOCS_DATASTORE_STANDARD=orquestor-support-collection_documents
DOCS_DATASTORE_MEDICAL=orquestor-support-collection_documents

# Host de core-api de produccion, sin slash final. Es el que tiene el engine
# desde el deploy del 2026-10-14. Si queda vacio, deploy.sh se detiene antes de
# subir nada.
CORE_API_BASE_URL=https://api.diagnostikare.com
